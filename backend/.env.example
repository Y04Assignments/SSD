# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/solarcharge_finder

# Authentication & Session Security (REQUIRED)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRE=30d
SESSION_SECRET=replace_with_a_secure_random_session_secret_at_least_32_characters

# Email Service Credentials (Optional for local dev, REQUIRED for email delivery)
EMAIL_USER=your_smtp_user@example.com
EMAIL_PASS=your_smtp_app_password

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# Facebook OAuth Credentials (Optional)
FACEBOOK_CLIENT_ID=your_facebook_client_id_placeholder
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret_placeholder
FACEBOOK_CALLBACK_URL=http://localhost:5001/api/auth/facebook/callback
